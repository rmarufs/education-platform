# Шаблон переменных окружения
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env

# Секретный ключ для подписи cookie-сессий (замени на случайную строку!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Окружение: development | production
APP_ENV=development

# В development docs и auto-migrations включены по умолчанию.
# В production задайте явно нужное поведение:
#   ENABLE_API_DOCS=false
#   AUTO_APPLY_MIGRATIONS=false
ENABLE_API_DOCS=true
AUTO_APPLY_MIGRATIONS=true

# URL подключения к базе данных PostgreSQL
DATABASE_URL=postgresql://user:password@localhost/dbname

# Cloudinary API (обязательно для загрузки изображений)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Опционально: время жизни сессии в секундах (по умолчанию 7 дней)
SESSION_MAX_AGE=604800

# Порт (используется при запуске через скрипт)
PORT=8000
