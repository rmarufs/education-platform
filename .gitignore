*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Виртуальное окружение ────────────────────────
venv/
env/
.venv/
.env/

# ── Переменные окружения (секреты) ──────────────
.env
.env.local
.env.*.local
config/.env
config/.env.production
config/.env.*.local

# ── База данных ──────────────────────────────────
data/database.db
data/*.db
data/*.sqlite3
*.db
*.sqlite3

