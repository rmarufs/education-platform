# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Виртуальное окружение ────────────────────────
venv/
env/
.venv/
.env/

# ── Переменные окружения (секреты) ──────────────
.env
.env.local
.env.*.local

# ── База данных ──────────────────────────────────
data/database.db
*.db
*.sqlite3

